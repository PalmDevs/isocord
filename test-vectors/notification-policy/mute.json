{
  "about": "Mute with an end time. Times in ms. A null end mutes for good. Muted, guildMuted and channelMuted are asked of the Notify policy and the Unread policy alike. A missing expectation is not asked.",
  "cases": [
    {
      "name": "no settings for the guild",
      "now": 1000,
      "channel": {
        "id": "c",
        "guildId": "g",
        "parentId": null
      },
      "settings": null,
      "expect": {
        "muted": false,
        "guildMuted": false,
        "channelMuted": false
      }
    },
    {
      "name": "guild muted for good",
      "now": 1000,
      "channel": {
        "id": "c",
        "guildId": "g",
        "parentId": null
      },
      "settings": {
        "mute": {
          "end": null
        },
        "channelMutes": {},
        "level": null,
        "channelLevels": {},
        "flags": 0,
        "channelFlags": {},
        "suppressEveryone": false,
        "suppressRoles": false
      },
      "expect": {
        "muted": true,
        "guildMuted": true,
        "channelMuted": false
      }
    },
    {
      "name": "guild muted until later",
      "now": 1000,
