+package com.swmansion.rnscreens.core.containers.stack.animation.engine
+
+import android.graphics.Outline
+import android.os.Build
+import android.view.RoundedCorner
+import android.view.View
+import android.view.ViewOutlineProvider
+import android.view.animation.PathInterpolator
+import androidx.activity.BackEventCompat
+import com.swmansion.rnscreens.core.containers.stack.animation.engine.binding.TrackBinding
+import com.swmansion.rnscreens.core.containers.stack.animation.engine.binding.bindTrack
+import com.swmansion.rnscreens.core.containers.stack.animation.timeline.Track
+import kotlin.math.abs
+import kotlin.math.sign
+
+private const val CARD_SCALE = 0.9f
+private const val EDGE_MARGIN_DP = 8f
+private const val INCOMING_PARALLAX_DP = 16f
+private const val FALLBACK_RADIUS_DP = 24f
+private const val COMMIT_SEEK_PORTION = 0.8f
+
+/** Android predictive back design: rounded surface, swipe edge, and bounded Y drag. */
+internal class PredictiveBackCard {
+    private val gestureCurve = PathInterpolator(0f, 0f, 0f, 1f)
+    private val frames = mutableSetOf<() -> Unit>()
+    private var firstTouchX: Float? = null
+    private var firstTouchY: Float? = null
+    private var dragX = 0f
+    private var dragY = 0f
+    private var edgeDirection = 1f
+    private var lastProgress = 0f
+    private var commitProgress: Float? = null
+    private var cancelProgress: Float? = null
+    private var settleProgress = 0f
+
+    fun update(event: BackEventCompat) {
+        val originX = firstTouchX ?: event.touchX.also { firstTouchX = it }
+        dragX = event.touchX - originX
+        val originY = firstTouchY ?: event.touchY.also { firstTouchY = it }
+        dragY = event.touchY - originY
+        lastProgress = event.progress
+        edgeDirection = if (event.swipeEdge == BackEventCompat.EDGE_RIGHT) -1f else 1f
+        frames.forEach { it() }
+    }
+
+    fun commit() {
+        if (firstTouchX != null) commitProgress = lastProgress
+    }
+
+    fun cancel() {
+        cancelProgress = lastProgress
+    }
+
+    fun bindIncoming(
+        track: Track.Translate,
+        view: View,
+        metrics: LayoutMetrics,
+        durationMs: Long,
+    ): TrackBinding {
+        val stock = bindTrack(track, view, metrics)
+        val from = track.from.toPx(track.axis, metrics)
+        val to = track.to.toPx(track.axis, metrics)
+        val maxParallax = minOf(INCOMING_PARALLAX_DP * metrics.density, abs(to - from)) * sign(to - from)
+        // DefaultPreset.slide easing for the remaining distance after commit.
+        val easing = Interpolators.of(track.timing.easing, view.context)
+        return object : TrackBinding {
+            private var fraction = 0f
+            private val draw = { drawFrame() }
+
+            override fun apply(timeMs: Float, eased: Boolean) {
+                fraction = (timeMs / durationMs).coerceIn(0f, 1f)
+                frames.add(draw)
+                if (firstTouchX == null) {
+                    stock.apply(timeMs, eased)
+                } else {
+                    drawFrame()
+                }
+            }
+
+            private fun drawFrame() {
+                val width = metrics.containerWidth.coerceAtLeast(1)
+                val touchRatio = (dragX * edgeDirection / width).coerceIn(0f, 1f)
+                val preview = from + maxParallax * touchRatio
+                view.translationX =
+                    if (commitProgress != null) {
+                        val progress = easing.getInterpolation(committedFraction(fraction))
+                        preview + (to - preview) * progress
+                    } else {
+                        // FragmentTransitionSupport: return the parallax as the cancel seek rewinds.
+                        val remaining = cancelProgress?.let {
+                            if (it > 0f) (fraction / it).coerceIn(0f, 1f) else 0f
+                        } ?: 1f
+                        from + (preview - from) * remaining
+                    }
+            }
+
+            override fun restore() {
+                frames.remove(draw)
+                stock.restore()
+            }
+        }
+    }
+
+    fun bind(view: View, durationMs: Long): TrackBinding =
+        object : TrackBinding {
+            private val originalOutline = view.outlineProvider
+            private val originalClipping = view.clipToOutline
+            private var changed = false
+            private var fraction = 0f
+            private val draw = { drawFrame() }
+
+            override fun apply(timeMs: Float, eased: Boolean) {
+                fraction = (timeMs / durationMs).coerceIn(0f, 1f)
+                frames.add(draw)
+                drawFrame()
+            }
+
+            private fun drawFrame() {
+                if (firstTouchY == null) return
+                val settle = committedFraction(fraction)
+                val visualFraction = commitProgress?.let { it + (1f - it) * settle } ?: fraction
+                val progress = gestureCurve.getInterpolation(visualFraction)
+                val scale = 1f - (1f - CARD_SCALE) * progress
+                val margin = EDGE_MARGIN_DP * view.resources.displayMetrics.density
+                val horizontalRoom = (view.width * (1f - CARD_SCALE) / 2f - margin).coerceAtLeast(0f)
+                val verticalRoom = (view.height * (1f - scale) / 2f - margin).coerceAtLeast(0f)
+                val halfHeight = (view.height / 2f).coerceAtLeast(1f)
+                val verticalProgress = (dragY / halfHeight).coerceIn(-1f, 1f)
+
+                view.translationX = horizontalRoom * progress * edgeDirection
+                view.translationY = verticalRoom * verticalProgress
+                view.scaleX = scale
+                view.scaleY = scale
+                view.alpha = 1f - settle
+                if (!changed) {
+                    view.outlineProvider = cardOutline(view)
+                    view.clipToOutline = true
+                }
+                changed = true
+            }
+
+            override fun restore() {
+                frames.remove(draw)
+                if (!changed) return
+                view.translationX = 0f
+                view.translationY = 0f
+                view.scaleX = 1f
+                view.scaleY = 1f
+                view.alpha = 1f
+                view.outlineProvider = originalOutline
+                view.clipToOutline = originalClipping
+                changed = false
+            }
+        }
+
+    private fun committedFraction(fraction: Float): Float {
+        val start = commitProgress ?: return 0f
+        // TransitionSeekController: finish before the spring's slow tail.
+        val end = start + (1f - start) * COMMIT_SEEK_PORTION
+        val progress = if (fraction >= end) 1f else ((fraction - start) / (end - start)).coerceAtLeast(0f)
+        settleProgress = maxOf(settleProgress, progress)
+        return settleProgress
+    }
+}
+
+private fun cardOutline(view: View): ViewOutlineProvider {
+    val deviceRadius =
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+            view.rootWindowInsets?.getRoundedCorner(RoundedCorner.POSITION_TOP_LEFT)?.radius ?: 0
+        } else {
+            0
+        }
+    val radius = if (deviceRadius > 0) deviceRadius.toFloat() else FALLBACK_RADIUS_DP * view.resources.displayMetrics.density
+    return object : ViewOutlineProvider() {
+        override fun getOutline(view: View, outline: Outline) =
+            outline.setRoundRect(0, 0, view.width, view.height, radius)
+    }
+}
