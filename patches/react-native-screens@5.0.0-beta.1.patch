+package com.swmansion.rnscreens.core.containers.stack.animation.engine
+
+import android.animation.Animator
+import android.animation.AnimatorListenerAdapter
+import android.animation.ValueAnimator
+import android.graphics.Canvas
+import android.graphics.Outline
+import android.graphics.Picture
+import android.os.Build
+import android.view.RoundedCorner
+import android.view.View
+import android.view.ViewGroup
+import android.view.ViewOutlineProvider
+import android.view.animation.LinearInterpolator
+import android.view.animation.PathInterpolator
+import androidx.activity.BackEventCompat
+import com.swmansion.rnscreens.core.containers.stack.animation.engine.binding.TrackBinding
+import com.swmansion.rnscreens.core.containers.stack.animation.engine.binding.ViewPropertyBinding
+import com.swmansion.rnscreens.core.containers.stack.animation.engine.binding.ViewTarget
+import com.swmansion.rnscreens.core.containers.stack.animation.engine.binding.bindTrack
+import com.swmansion.rnscreens.core.containers.stack.animation.presets.defaultPreset
+import com.swmansion.rnscreens.core.containers.stack.animation.timeline.Axis
+import com.swmansion.rnscreens.core.containers.stack.animation.timeline.ScreenTimeline
+import com.swmansion.rnscreens.core.containers.stack.animation.timeline.Track
+import com.swmansion.rnscreens.core.containers.stack.animation.timeline.ViewProperty
+import kotlin.math.abs
+import kotlin.math.sign
+
+private const val CARD_SCALE = 0.9f
+private const val EDGE_MARGIN_DP = 8f
+private const val INCOMING_PARALLAX_DP = 16f
+private const val FALLBACK_RADIUS_DP = 24f
+
+/** Android predictive back design: rounded surface, swipe edge, and bounded Y drag. */
+internal class PredictiveBackCard {
+    private val gestureCurve = PathInterpolator(0f, 0f, 0f, 1f)
+    private val frames = mutableSetOf<() -> Unit>()
+    private var firstTouchX: Float? = null
+    private var firstTouchY: Float? = null
+    private var dragX = 0f
+    private var dragY = 0f
+    private var edgeDirection = 1f
+    private var lastProgress = 0f
+    private var cancelProgress: Float? = null
+    private var transitionPrepared = false
+    private var commitTimeMs: Float? = null
+    private var commitFinished = false
+
+    fun update(event: BackEventCompat) {
+        val originX = firstTouchX ?: event.touchX.also { firstTouchX = it }
+        dragX = event.touchX - originX
+        val originY = firstTouchY ?: event.touchY.also { firstTouchY = it }
+        dragY = event.touchY - originY
+        lastProgress = event.progress
+        edgeDirection = if (event.swipeEdge == BackEventCompat.EDGE_RIGHT) -1f else 1f
+        frames.forEach { it() }
+    }
+
+    // FragmentManager resolves seek transitions before commit, even without a progress event.
+    fun prepareTransition() {
+        transitionPrepared = true
+    }
+
+    fun createCommitAnimator(): Animator? {
+        if (cancelProgress != null || (!transitionPrepared && firstTouchX == null)) return null
+
+        // DefaultPreset.slide runs from the release position on its full playhead.
+        val slideDuration = defaultPreset().pop.durationMs
+        commitTimeMs = 0f
+        return ValueAnimator.ofFloat(0f, 1f).apply {
+            duration = slideDuration
+            interpolator = LinearInterpolator()
+            addUpdateListener {
+                commitTimeMs = it.animatedFraction * slideDuration
+                frames.forEach { draw -> draw() }
+            }
+            addListener(object : AnimatorListenerAdapter() {
+                override fun onAnimationEnd(animation: Animator) {
+                    commitFinished = true
+                    frames.clear()
+                }
+            })
+        }
+    }
+
+    fun cancel() {
+        cancelProgress = lastProgress
+    }
+
+    fun bindIncoming(
+        track: Track.Translate,
+        view: View,
+        metrics: LayoutMetrics,
+        durationMs: Long,
+    ): TrackBinding {
+        val stock = bindTrack(track, view, metrics)
+        val from = track.from.toPx(track.axis, metrics)
+        val to = track.to.toPx(track.axis, metrics)
+        val maxParallax = minOf(INCOMING_PARALLAX_DP * metrics.density, abs(to - from)) * sign(to - from)
+        // DefaultPreset.slide easing for the remaining distance after commit.
+        val easing = Interpolators.of(track.timing.easing, view.context)
+        return object : TrackBinding {
+            private val originalOutline = view.outlineProvider
+            private val originalClipping = view.clipToOutline
+            private var rounded = false
+            private var fraction = 0f
+            private val draw = { drawFrame() }
+
+            override fun apply(timeMs: Float, eased: Boolean) {
+                fraction = (timeMs / durationMs).coerceIn(0f, 1f)
+                if (!commitFinished) frames.add(draw)
+                if (firstTouchX == null && commitTimeMs == null) {
+                    stock.apply(timeMs, eased)
+                } else {
+                    drawFrame()
+                }
+            }
+
+            private fun drawFrame() {
+                val width = metrics.containerWidth.coerceAtLeast(1)
+                val touchRatio = (dragX * edgeDirection / width).coerceIn(0f, 1f)
+                val preview = from + maxParallax * touchRatio
+                val playTime = commitTimeMs
+                if (playTime != null && playTime >= track.timing.endMs) {
+                    restoreOutline()
+                } else if (!rounded) {
+                    view.outlineProvider = cardOutline(view)
+                    view.clipToOutline = true
+                    rounded = true
+                }
+                view.translationX =
+                    if (playTime != null) {
+                        val progress = easing.getInterpolation(track.timing.progressAt(playTime))
+                        preview + (to - preview) * progress
+                    } else {
+                        // FragmentTransitionSupport: return the parallax as the cancel seek rewinds.
+                        val remaining = cancelProgress?.let {
+                            if (it > 0f) (fraction / it).coerceIn(0f, 1f) else 0f
+                        } ?: 1f
+                        from + (preview - from) * remaining
+                    }
+            }
+
+            override fun restore() {
+                // The seek controller can finish before the incoming slide's full duration.
+                val playTime = commitTimeMs
+                if (playTime != null && playTime < track.timing.endMs) return
+                frames.remove(draw)
+                stock.restore()
+                restoreOutline()
+            }
+
+            private fun restoreOutline() {
+                if (!rounded) return
+                view.outlineProvider = originalOutline
+                view.clipToOutline = originalClipping
+                rounded = false
+            }
+        }
+    }
+
+    fun bindOutgoing(
+        view: View,
+        sceneRoot: ViewGroup,
+        metrics: LayoutMetrics,
+        timeline: ScreenTimeline,
+    ): TrackBinding {
+        val slide = timeline.tracks.filterIsInstance<Track.Translate>().firstOrNull { it.axis == Axis.LOGICAL_X }
+        val opacity = timeline.tracks.filterIsInstance<Track.Property>().firstOrNull { it.property == ViewProperty.OPACITY }
+        return object : TrackBinding {
+            private val originalOutline = view.outlineProvider
+            private val originalClipping = view.clipToOutline
+            private var changed = false
+            private var fraction = 0f
+            private var previewX = 0f
+            private var exitSlide: TrackBinding? = null
+            private var fade = opacity?.let { bindTrack(it, view, metrics) }
+            private var snapshot: View? = null
+            private var commitRestored = false
+            private val draw = { drawFrame() }
+
+            override fun apply(timeMs: Float, eased: Boolean) {
+                if (commitRestored) return
+                fraction = (timeMs / timeline.durationMs).coerceIn(0f, 1f)
+                if (!commitFinished) frames.add(draw)
+                drawFrame()
+            }
+
+            private fun drawFrame() {
+                val playTime = commitTimeMs
+                if (playTime != null) {
+                    drawExit(playTime)
+                    return
+                }
+                if (firstTouchY == null) return
+                val progress = gestureCurve.getInterpolation(fraction)
+                val scale = 1f - (1f - CARD_SCALE) * progress
+                val margin = EDGE_MARGIN_DP * view.resources.displayMetrics.density
+                val horizontalRoom = (view.width * (1f - CARD_SCALE) / 2f - margin).coerceAtLeast(0f)
+                val verticalRoom = (view.height * (1f - scale) / 2f - margin).coerceAtLeast(0f)
+                val halfHeight = (view.height / 2f).coerceAtLeast(1f)
+                val verticalProgress = (dragY / halfHeight).coerceIn(-1f, 1f)
+
+                previewX = horizontalRoom * progress * edgeDirection
+                view.translationX = previewX
+                view.translationY = verticalRoom * verticalProgress
+                view.scaleX = scale
+                view.scaleY = scale
+                view.alpha = 1f
+                if (!changed) {
+                    view.outlineProvider = cardOutline(view)
+                    view.clipToOutline = true
+                }
+                changed = true
+            }
+
+            private fun drawExit(playTime: Float) {
+                if (commitRestored && snapshot == null) return
+                val target = snapshot ?: view
+                if (exitSlide == null && slide != null) {
+                    exitSlide = ViewPropertyBinding(
+                        target,
+                        ViewTarget.TRANSLATION_X,
+                        from = previewX,
+                        to = slide.to.toPx(slide.axis, metrics),
+                        timing = slide.timing,
+                        interpolator = Interpolators.of(slide.timing.easing, target.context),
+                    )
+                }
+                exitSlide?.apply(playTime, eased = true)
+                fade?.apply(playTime, eased = true)
+                if (snapshot != null && playTime >= opacityEndMs) {
+                    sceneRoot.overlay.remove(target)
+                    snapshot = null
+                    exitSlide = null
+                    fade = null
+                }
+            }
+
+            private val opacityEndMs = opacity?.timing?.endMs ?: timeline.durationMs
+
+            override fun restore() {
+                if (commitRestored) return
+                val playTime = commitTimeMs
+                commitRestored = playTime != null
+                // Visibility.OverlayListener can remove the live view before the fade ends.
+                val retained = if (playTime != null && playTime < opacityEndMs) {
+                    retainOutgoingFrame(view, sceneRoot)
+                } else {
+                    null
+                }
+                if (retained == null || playTime == null) {
+                    frames.remove(draw)
+                } else {
+                    snapshot = retained
+                    exitSlide = null
+                    fade = opacity?.let { bindTrack(it, retained, metrics) }
+                    drawExit(playTime)
+                    frames.add(draw)
+                }
+                if (!changed) return
+                view.translationX = 0f
+                view.translationY = 0f
+                view.scaleX = 1f
+                view.scaleY = 1f
+                view.alpha = 1f
+                view.outlineProvider = originalOutline
+                view.clipToOutline = originalClipping
+                changed = false
+            }
+        }
+    }
+}
+
+private fun retainOutgoingFrame(view: View, host: ViewGroup): View? {
+    if (!view.isAttachedToWindow || view.width <= 0 || view.height <= 0) return null
+
+    // Picture.draw: replay text and shapes at the final transform.
+    val frame = Picture()
+    val canvas = frame.beginRecording(view.width, view.height)
+    try {
+        view.draw(canvas)
+    } finally {
+        frame.endRecording()
+    }
+    return object : View(host.context) {
+        override fun onDraw(canvas: Canvas) {
+            canvas.drawPicture(frame)
+        }
+    }.apply {
+        layout(view.left, view.top, view.right, view.bottom)
+        pivotX = view.pivotX
+        pivotY = view.pivotY
+        translationY = view.translationY
+        scaleX = view.scaleX
+        scaleY = view.scaleY
+        outlineProvider = view.outlineProvider
+        clipToOutline = view.clipToOutline
+        host.overlay.add(this)
+    }
+}
+
+private fun cardOutline(view: View): ViewOutlineProvider {
+    val deviceRadius =
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+            view.rootWindowInsets?.getRoundedCorner(RoundedCorner.POSITION_TOP_LEFT)?.radius ?: 0
+        } else {
+            0
+        }
+    val radius = if (deviceRadius > 0) deviceRadius.toFloat() else FALLBACK_RADIUS_DP * view.resources.displayMetrics.density
+    return object : ViewOutlineProvider() {
+        override fun getOutline(view: View, outline: Outline) =
+            outline.setRoundRect(0, 0, view.width, view.height, radius)
+    }
+}
