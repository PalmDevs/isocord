{
  "name": "isocord",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android --appIdSuffix debug",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check",
    "format": "biome check --write",
    "extract": "bun scripts/extract-tokens.ts ../discord-mobile-datamining",
    "twemoji": "bash scripts/fetch-twemoji.sh",
    "postinstall": "test -f android/app/src/main/assets/twemoji/Twemoji.ttf || bun run twemoji"
  },
  "dependencies": {
    "@callstack/liquid-glass": "^0.8.2",
    "@hcaptcha/react-native-hcaptcha": "^4.1.0",
    "@react-navigation/bottom-tabs": "^8.0.0-alpha.57",
    "@react-navigation/native": "^8.0.0-alpha.51",
    "@react-navigation/native-stack": "file:vendor/react-navigation-native-stack-55c1d647.tgz",
    "@shopify/flash-list": "^2.3.3",
    "@tanstack/react-query": "^5.108.4",
    "@twemoji/parser": "17.0.2",
    "expo": "~58.1.0",
    "expo-clipboard": "~58",
    "expo-crypto": "~58",
    "expo-device": "~58",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.15",
    "expo-image": "~58.0.19",
    "expo-image-picker": "~58.0.10",
    "expo-media-library": "~58.0.14",
    "expo-web-browser": "~58",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "react": "19.3.1",
    "react-native": "0.89.0-rc.3",
    "react-native-edge-to-edge": "^1.8.2",
    "react-native-gesture-handler": "^3.5.0",
    "react-native-keyboard-controller": "^1.24.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-pager-view": "^10.0.3",
    "react-native-reanimated": "^4.8.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^5.0.0-beta.1",
    "react-native-svg": "^15.16.1",
    "react-native-unistyles": "^3.9.0",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "^0.14.0",
    "simple-markdown": "^0.7.3",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.16",
    "@babel/preset-env": "^7.29.14",
    "@babel/runtime": "^7.29.16",
    "@biomejs/biome": "^2.6.9",
    "@react-native-community/cli": "21.0.0",
    "@react-native-community/cli-platform-android": "21.0.0",
    "@react-native/babel-preset": "0.89.0-rc.3",
    "@react-native/community-cli-plugin": "0.89.0-rc.3",
    "@react-native/metro-config": "0.89.0-rc.3",
    "@react-native/typescript-config": "0.89.0-rc.3",
    "@types/bun": "^1.4.5",
    "@types/react": "^19.3.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "babel-preset-expo": "~58.0.27",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "codegenConfig": {
    "name": "IsocordSpec",
    "type": "all",
    "jsSrcsDir": "src/native",
    "android": {
      "javaPackageName": "me.palmdevs.isocord.specs"
    }
  },
  "patchedDependencies": {
    "react-native-edge-to-edge@1.8.2": "patches/react-native-edge-to-edge@1.8.2.patch",
    "react-native-screens@5.0.0-beta.1": "patches/react-native-screens@5.0.0-beta.1.patch",
    "@shopify/flash-list@2.3.3": "patches/@shopify%2Fflash-list@2.3.3.patch",
    "react-native-reanimated@4.8.0": "patches/react-native-reanimated@4.8.0.patch"
  },
  "reanimated": {
    "staticFeatureFlags": {
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true,
      "USE_ANIMATION_BACKEND": true,
      "FORCE_REACT_RENDER_FOR_SETTLED_ANIMATIONS": false
    }
  }
}
