{
  "name": "isocord",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android --appIdSuffix debug",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check",
    "format": "biome check --write",
    "extract": "bun scripts/extract-tokens.ts ../discord-mobile-datamining",
    "twemoji": "bash scripts/fetch-twemoji.sh",
    "postinstall": "test -f android/app/src/main/assets/twemoji/Twemoji.ttf || bun run twemoji"
  },
  "dependencies": {
    "@hcaptcha/react-native-hcaptcha": "^4.1.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@shopify/flash-list": "^2.3.3",
    "@tanstack/react-query": "^5.107.1",
    "@twemoji/parser": "17.0.1",
    "expo": "~58.0.0",
    "expo-clipboard": "~58",
    "expo-crypto": "~58",
    "expo-device": "~58",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-media-library": "~58.0.14",
    "expo-web-browser": "~58",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "highlight.js": "^11.12.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-edge-to-edge": "^1.8.2",
    "react-native-gesture-handler": "^3.5.0",
    "react-native-keyboard-controller": "^1.23.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-pager-view": "^10.0.0",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.30.1",
    "react-native-svg": "^15.16.1",
    "react-native-unistyles": "^3.8.1",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "^0.13.1",
    "simple-markdown": "^0.7.3",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@biomejs/biome": "^2.6.7",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.2.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "babel-preset-expo": "~58.0.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "codegenConfig": {
    "name": "IsocordSpec",
    "type": "all",
    "jsSrcsDir": "src/native",
    "android": {
      "javaPackageName": "me.palmdevs.isocord.specs"
    }
  },
  "patchedDependencies": {
    "react-native-unistyles@3.8.1": "patches/react-native-unistyles@3.8.1.patch",
    "react-native-edge-to-edge@1.8.2": "patches/react-native-edge-to-edge@1.8.2.patch"
  }
}
